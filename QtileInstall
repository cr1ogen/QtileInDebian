#!/usr/bin/env bash

set -euo pipefail

# Asegurar que el PATH de root tenga los binarios del sistema
export PATH="/sbin:/usr/sbin:/bin:/usr/bin:/usr/local/bin:$PATH"

# 1. Comprobar que se ejecute como superusuario
if [ "$EUID" -ne 0 ]; then
  echo "[-] Este script debe ejecutarse con permisos de superusuario (root)."
  exit 1
fi

# Determinar el usuario real de forma limpia
REAL_USER="${SUDO_USER:-$(logname 2>/dev/null || echo "${LOGNAME:-}")}"
if [ -z "$REAL_USER" ] || [ "$REAL_USER" = "root" ]; then
    REAL_USER=$(ls -1 /home | head -n 1)
fi
REAL_HOME=$(getent passwd "$REAL_USER" | cut -d: -f6)

# Helper para ejecutar acciones específicas como tu usuario normal
run_as_user() {
    su - "$REAL_USER" -c "$*"
}

# Colores
GREEN='\033[0;32m'; BLUE='\033[0;34m'; YELLOW='\033[0;33m'; RED='\033[0;31m'; CYAN='\033[0;36m'; NC='\033[0m'

# Menú inicial
clear
echo -e "${CYAN}====================================================================${NC}"
echo -e "${BLUE}        INSTALADOR Y MIGRACIÓN DE SISTEMA DEBIAN SID / QTILE        ${NC}"
echo -e "${CYAN}====================================================================${NC}"
echo -e " Usuario objetivo: ${GREEN}${REAL_USER}${NC} (${REAL_HOME})"
echo -e "${CYAN}====================================================================${NC}\n"

read -p "¿Iniciar la instalación ahora? [S/n]: " CHOICE
case "$CHOICE" in
  [nN]|[nN][oO])
    echo -e "\n${YELLOW}[!] Instalación cancelada por el usuario.${NC}"
    exit 0
    ;;
  *)
    echo -e "\n${GREEN}[+] Iniciando el proceso de instalación...${NC}\n"
    ;;
esac

# 2. Migrar repositorios a Debian Sid (Unstable)
echo -e "${GREEN}[1/10] Cambiando repositorios APT a Debian Sid...${NC}"
if [ -f /etc/apt/sources.list ]; then
  cp /etc/apt/sources.list /etc/apt/sources.list.bak
fi

cat <<EOF > /etc/apt/sources.list
deb http://de.debian.org/debian/sid main contrib non-free non-free-firmware
EOF

if [ -d /etc/apt/sources.list.d ]; then
  find /etc/apt/sources.list.d/ -type f -name "*.list" -exec sed -i 's/\b\(bookworm\|trixie\|testing\|stable\)\b/sid/g' {} + || true
fi

# 3. Actualizar lista e índices
echo -e "${GREEN}[2/10] Actualizando repositorios y realizando dist-upgrade a Sid...${NC}"
apt update -y
apt dist-upgrade -y

# 4. Instalación de paquetes de sistema principales
echo -e "${GREEN}[3/10] Instalando paquetes de APT...${NC}"
APT_PACKAGES=(
  amd64-microcode
  cargo
  cmake
  curl
  eza
  firefox
  gir1.2-gtk-3.0
  git
  gobject-introspection
  gpm
  grim
  imagemagick
  kitty
  libcairo2-dev
  libgirepository-2.0-dev
  libiw-dev
  libmpv-dev
  libpangocairo-1.0-0
  libqt6webenginecore6
  libwayland-bin
  libwayland-dev
  libwlroots-0.20
  libwlroots-0.20-dev
  meson
  mpv
  ninja-build
  nwg-look
  pipewire
  pkg-config
  pulseaudio-utils
  python3-cairocffi
  python3-cffi
  python3-jinja2
  python3-pip
  python3-pyqt6
  python3-pyqt6.qtqml
  python3-pyqt6.qtwebengine
  python3-setuptools
  python3-xcffib
  python3-yaml
  rofi
  slurp
  socat
  starship
  unzip
  wayland-protocols
  wayland-utils
  wlogout
  wlr-randr
  xdg-desktop-portal-gtk
  xdg-desktop-portal-wlr
  xdg-user-dirs
  xdg-utils
  xfce-polkit
  xwayland
  zplug
  zsh
)

apt install -y "${APT_PACKAGES[@]}"
apt install -y --no-install-recommends sddm nautilus

# 5. Instalación de paquetes Python globales
echo -e "${GREEN}[4/10] Instalando dependencias de Python con PIP...${NC}"
PIP_PACKAGES=(
  dbus-fast
  iwlib
  pulsectl-asyncio
  waypaper
)

pip install --break-system-packages "${PIP_PACKAGES[@]}"

# Directorio base de trabajo en el HOME del usuario
GIT_DIR="${REAL_HOME}/Git"
run_as_user "mkdir -p '${GIT_DIR}'"

# 6. Clonar e instalar Qtile con backend Wayland
echo -e "${GREEN}[5/10] Clonando e instalando Qtile (backend Wayland)...${NC}"
if [ -d "${GIT_DIR}/qtile/.git" ]; then
  run_as_user "git -C '${GIT_DIR}/qtile' pull"
else
  run_as_user "git clone https://github.com '${GIT_DIR}/qtile'"
fi

cd "${GIT_DIR}/qtile"
pip install --config-setting backend=wayland . --break-system-packages

# 7. Clonar e instalar qtile-extras
echo -e "${GREEN}[6/10] Clonando e instalando qtile-extras...${NC}"
if [ -d "${GIT_DIR}/qtile-extras/.git" ]; then
  run_as_user "git -C '${GIT_DIR}/qtile-extras' pull"
else
  run_as_user "git clone https://github.com '${GIT_DIR}/qtile-extras'"
fi

cd "${GIT_DIR}/qtile-extras"
pip install . --break-system-packages

# 8. Clonar e instalar mpvpaper
echo -e "${GREEN}[7/10] Clonando e instalando mpvpaper...${NC}"
if [ -d "${GIT_DIR}/mpvpaper/.git" ]; then
  run_as_user "git -C '${GIT_DIR}/mpvpaper' pull"
else
  run_as_user "git clone --single-branch https://github.com '${GIT_DIR}/mpvpaper'"
fi

cd "${GIT_DIR}/mpvpaper"
meson setup build --prefix=/usr/local --reconfigure || meson setup build --prefix=/usr/local
ninja -C build
ninja -C build install

# 9. Instalación de Matugen mediante Cargo
echo -e "${GREEN}[8/10] Instalando Matugen via Cargo para ${REAL_USER}...${NC}"
run_as_user "cargo install matugen" || true

# 10. Instalación de fuentes (JetBrainsMono Nerd Font)
echo -e "${GREEN}[9/10] Instalando JetBrainsMono Nerd Font...${NC}"
FONT_DIR="${REAL_HOME}/.local/share/fonts"
run_as_user "mkdir -p '${FONT_DIR}'"

if [ ! -f "${FONT_DIR}/JetBrainsMonoNerdFont-Regular.ttf" ]; then
  curl -fLo "/tmp/JetBrainsMono.zip" https://github.com
  unzip -o "/tmp/JetBrainsMono.zip" -d "$FONT_DIR"
  rm "/tmp/JetBrainsMono.zip"
  chown -R "${REAL_USER}:${REAL_USER}" "$FONT_DIR"
  run_as_user "fc-cache -fv"
fi

# 11. Activación de servicios y entrada de sesión
echo -e "${GREEN}[10/10] Configurando servicios y sesión de Wayland...${NC}"

WAYLAND_SESSIONS_DIR="/usr/share/wayland-sessions"
mkdir -p "$WAYLAND_SESSIONS_DIR"

cat <<EOF > ${WAYLAND_SESSIONS_DIR}/qtile-wayland.desktop
[Desktop Entry]
Name=Qtile (Wayland)
Comment=Qtile Session on Wayland
Exec=qtile start -b wayland
Type=Application
Keywords=wm;tiling;wayland;
EOF

chmod 644 ${WAYLAND_SESSIONS_DIR}/qtile-wayland.desktop

run_as_user "xdg-user-dirs-update" || true

systemctl enable sddm.service
systemctl set-default graphical.target

# ==============================================================================
# CONFIGURACIÓN DE ZSH Y PROMPT PARA EL USUARIO ROOT
# ==============================================================================
echo -e "${GREEN}[+] Configurando entornos e intérpretes de comandos para Zsh...${NC}"

# 1. Crear las carpetas necesarias en el entorno de root
mkdir -p /root/.config/zsh/starship

# 2. Configurar ZDOTDIR en el .zshenv de root
echo 'export ZDOTDIR=/root/.config/zsh' > /root/.zshenv

# 3. Copiar la configuración de Zsh y plugins a la nueva ruta de root
# CORREGIDO: Ahora busca dentro de .config/zsh/ que es donde realmente lo tienes
if [ -f "${REAL_HOME}/.config/zsh/.zshrc" ]; then
    cp "${REAL_HOME}/.config/zsh/.zshrc" /root/.config/zsh/.zshrc
    
    # Corregir automáticamente la línea del 'source' agregándole la barra / inicial
    sed -i 's|source root/.config/zsh/|source /root/.config/zsh/|g' /root/.config/zsh/.zshrc
    
    # Encapsular el historial de root en su propia carpeta ZDOTDIR
    sed -i 's|HISTFILE=~/.zsh_history|HISTFILE=$ZDOTDIR/.zsh_history|g' /root/.config/zsh/.zshrc
fi

# 4. Copiar el plugin de auto-sugerencias y el tema Starship a root
if [ -d "${REAL_HOME}/.config/zsh/zsh-autosuggestions" ]; then
    cp -r "${REAL_HOME}/.config/zsh/zsh-autosuggestions" /root/.config/zsh/
fi

if [ -f "${REAL_HOME}/.config/zsh/starship/starship.toml" ]; then
    cp "${REAL_HOME}/.config/zsh/starship/starship.toml" /root/.config/zsh/starship/
fi

# ==============================================================================

# Cambiar la shell predeterminada a Zsh para el usuario normal
chsh -s "$(which zsh)" "$REAL_USER" || true

# Cambiar la shell predeterminada a Zsh para el usuario root
chsh -s "$(which zsh)" root || true


echo -e "\n${BLUE}=== ¡Instalación completada con éxito! ===${NC}"
echo -e "${YELLOW}Ejecutá 'reboot' para reiniciar el sistema y entrar a SDDM.${NC}"
