#!/usr/bin/env bash

set -euo pipefail

# Comprobar que se ejecute estrictamente con sudo
if [ "$EUID" -ne 0 ]; then
  echo "[-] Este script debe ejecutarse con permisos de superusuario."
  echo "    Por favor, corrrelo así: sudo $0"
  exit 1
fi

# Determinar el usuario real que invocó sudo
REAL_USER="${SUDO_USER:-$USER}"
REAL_HOME=$(getent passwd "$REAL_USER" | cut -d: -f6)

# Colores para la salida en consola
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# 1. Menú de bienvenida y confirmación
clear
echo -e "${CYAN}====================================================================${NC}"
echo -e "${BLUE}        INSTALADOR Y MIGRACIÓN DE SISTEMA DEBIAN SID / QTILE        ${NC}"
echo -e "${CYAN}====================================================================${NC}"
echo -e " Usuario objetivo: ${GREEN}${REAL_USER}${NC} (${REAL_HOME})"
echo -e " Este script realizará las siguientes acciones en tu sistema:"
echo -e "   1. Migración de repositorios APT a Debian Sid (Unstable)."
echo -e "   2. Instalación de paquetes de sistema (APT, SDDM, Nautilus)."
echo -e "   3. Instalación de paquetes Python globales (Waypaper, etc.)."
echo -e "   4. Compilación e instalación de Qtile (Wayland) y qtile-extras."
echo -e "   5. Compilación e instalación de mpvpaper."
echo -e "   6. Instalación de Matugen mediante Cargo."
echo -e "   7. Descarga e instalación de JetBrainsMono Nerd Font y Papirus-Folder icons."
echo -e "   8. Configuración de sesión Wayland, SDDM y cambio de shell a Zsh."
echo -e "${CYAN}====================================================================${NC}\n"

echo -e "¿Qué deseas hacer?"
echo -e "  ${GREEN}[1]${NC} Iniciar la instalación ahora"
echo -e "  ${RED}[2]${NC} Cancelar y salir"
echo ""
read -p "Selecciona una opción [1/2] (por defecto 1): " CHOICE

case "$CHOICE" in
  2|[nN]|[nN][oO])
    echo -e "\n${YELLOW}[!] Instalación cancelada por el usuario. Saliendo...${NC}"
    exit 0
    ;;
  *)
    echo -e "\n${GREEN}[+] Iniciando el proceso de instalación...${NC}\n"
    ;;
esac

# 2. Migrar repositorios a Debian Sid (Unstable)
echo -e "${GREEN}[1/10] Cambiando repositorios APT a Debian Sid...${NC}"

if [ -f /etc/apt/sources.list ]; then
  echo -e "${GREEN}[+] Realizando backup de sources.list...${NC}"
  cp /etc/apt/sources.list /etc/apt/sources.list.bak
fi

echo -e "${GREEN}[+] Reconfigurando /etc/apt/sources.list para Sid...${NC}"
cat <<EOF > /etc/apt/sources.list
deb http://deb.debian.org/debian/ sid main contrib non-free non-free-firmware
# deb-src http://deb.debian.org/debian/ sid main contrib non-free non-free-firmware
EOF

if [ -d /etc/apt/sources.list.d ]; then
  find /etc/apt/sources.list.d/ -type f -name "*.list" -exec sed -i 's/\b\(bookworm\|trixie\|testing\|stable\)\b/sid/g' {} + || true
fi

# 3. Actualizar lista e índices de paquetes a Sid
echo -e "${GREEN}[2/10] Actualizando repositorios y realizando dist-upgrade a Sid...${NC}"
apt update -y
apt dist-upgrade -y

# 4. Instalación de paquetes de sistema principales
echo -e "${GREEN}[3/10] Instalando paquetes de APT...${NC}"
APT_PACKAGES=(
  amd64-microcode
  cargo
  cmake
  curl
  eza
  firefox
  gir1.2-gtk-3.0
  git
  gobject-introspection
  gpm
  grim
  imagemagick
  kitty
  libcairo2-dev
  libgirepository-2.0-dev
  libiw-dev
  libmpv-dev
  libpangocairo-1.0-0
  libqt6webenginecore6
  libwayland-bin
  libwayland-dev
  libwlroots-0.20
  libwlroots-0.20-dev
  meson
  ninja-build
  nwg-look
  pipewire
  pkg-config
  pulseaudio-utils
  python3-cairocffi
  python3-cffi
  python3-jinja2
  python3-pip
  python3-pyqt6
  python3-pyqt6.qtqml
  python3-pyqt6.qtwebengine
  python3-setuptools
  python3-xcffib
  python3-yaml
  rofi
  slurp
  socat
  starship
  unzip
  wayland-protocols
  wayland-utils
  wlogout
  wlr-randr
  xdg-desktop-portal-gtk
  xdg-desktop-portal-wlr
  xdg-user-dirs
  xdg-utils
  xfce-polkit
  xwayland
  zplug
  zsh
)

apt install -y "${APT_PACKAGES[@]}"

echo -e "${GREEN}[+] Instalando SDDM y Nautilus (sin recomendados)...${NC}"
apt install -y --no-install-recommends sddm nautilus

# 5. Instalación de dependencias de Python via PIP
echo -e "${GREEN}[4/10] Instalando dependencias de Python con PIP...${NC}"
PIP_PACKAGES=(
  dbus-fast
  iwlib
  pulsectl-asyncio
  waypaper
)

python3 -m pip install --break-system-packages "${PIP_PACKAGES[@]}"

# Directorio base de trabajo dentro del HOME del usuario
GIT_DIR="${REAL_HOME}/Git"
sudo -u "$REAL_USER" mkdir -p "$GIT_DIR"

# 6. Clonar e instalar Qtile con soporte Wayland
echo -e "${GREEN}[5/10] Clonando e instalar Qtile (backend Wayland)...${NC}"

if [ -d "${GIT_DIR}/qtile/.git" ]; then
  echo -e "${YELLOW}[!] El repositorio Qtile ya existe, actualizando...${NC}"
  sudo -u "$REAL_USER" git -C "${GIT_DIR}/qtile" pull
else
  sudo -u "$REAL_USER" git clone https://github.com/qtile/qtile.git "${GIT_DIR}/qtile"
fi

cd "${GIT_DIR}/qtile"
pip install --config-setting backend=wayland . --break-system-packages

# 7. Clonar e instalar qtile-extras
echo -e "${GREEN}[6/10] Clonando e instalar qtile-extras...${NC}"

if [ -d "${GIT_DIR}/qtile-extras/.git" ]; then
  echo -e "${YELLOW}[!] El repositorio qtile-extras ya existe, actualizando...${NC}"
  sudo -u "$REAL_USER" git -C "${GIT_DIR}/qtile-extras" pull
else
  sudo -u "$REAL_USER" git clone https://github.com/elParaguayo/qtile-extras.git "${GIT_DIR}/qtile-extras"
fi

cd "${GIT_DIR}/qtile-extras"
pip install . --break-system-packages

# 8. Clonar e instalar mpvpaper
echo -e "${GREEN}[7/10] Clonando e instalar mpvpaper...${NC}"

if [ -d "${GIT_DIR}/mpvpaper/.git" ]; then
  echo -e "${YELLOW}[!] El repositorio mpvpaper ya existe, actualizando...${NC}"
  sudo -u "$REAL_USER" git -C "${GIT_DIR}/mpvpaper" pull
else
  sudo -u "$REAL_USER" git clone --single-branch https://github.com/GhostNaN/mpvpaper "${GIT_DIR}/mpvpaper"
fi

cd "${GIT_DIR}/mpvpaper"
meson setup build --prefix=/usr/local --reconfigure || meson setup build --prefix=/usr/local
ninja -C build
ninja -C build install

# 9. Instalación de Matugen con Cargo (se compila como usuario normal)
echo -e "${GREEN}[8/10] Instalando matugen via Cargo para ${REAL_USER}...${NC}"
sudo -u "$REAL_USER" cargo install matugen || true

# 10. Instalación de Fuentes (JetBrains Mono Nerd Font)
echo -e "${GREEN}[9/10] Instalando JetBrainsMono Nerd Font...${NC}"
FONT_DIR="${REAL_HOME}/.local/share/fonts"
sudo -u "$REAL_USER" mkdir -p "$FONT_DIR"

if [ ! -f "${FONT_DIR}/JetBrainsMonoNerdFont-Regular.ttf" ]; then
  echo -e "${GREEN}[+] Descargando archivo de fuentes...${NC}"
  curl -fLo "/tmp/JetBrainsMono.zip" https://github.com/ryanoasis/nerd-fonts/releases/latest/download/JetBrainsMono.zip
  unzip -o "/tmp/JetBrainsMono.zip" -d "$FONT_DIR"
  rm "/tmp/JetBrainsMono.zip"
  chown -R "${REAL_USER}:${REAL_USER}" "$FONT_DIR"
  sudo -u "$REAL_USER" fc-cache -fv
else
  echo -e "${YELLOW}[!] La fuente JetBrainsMono Nerd Font ya está instalada.${NC}"
fi


# 11. Instalación de Temas e Iconos (Papirus Folders)
echo -e "\n Instalando y configurando Papirus Folders..."

# Crear el directorio de temas en el sistema si no existe
sudo mkdir -p /usr/share/icons 

# Descargar e instalar el script oficial de papirus-folders
if ! command -v papirus-folders &> /dev/null; then
  wget -qO- https://raw.githubusercontent.com/PapirusDevelopmentTeam/papirus-folders/master/install.sh | sudo sh
fi

echo -e " [✔] Papirus Folders preparado en el sistema."

# 12. Activación de servicios y configuración del entorno de usuario
echo -e "${GREEN}[10/10] Configurando servicios, sesión de Wayland y usuario...${NC}"

WAYLAND_SESSIONS_DIR="/usr/share/wayland-sessions"
mkdir -p "$WAYLAND_SESSIONS_DIR"

echo -e "${GREEN}[+] Creando archivo de sesión Qtile Wayland...${NC}"
cat <<EOF > ${WAYLAND_SESSIONS_DIR}/qtile-wayland.desktop
[Desktop Entry]
Name=Qtile (Wayland)
Comment=Qtile Session on Wayland
Exec=qtile start -b wayland
Type=Application
Keywords=wm;tiling;wayland;
EOF

chmod 644 ${WAYLAND_SESSIONS_DIR}/qtile-wayland.desktop

if command -v xdg-user-dirs-update &> /dev/null; then
  echo -e "${GREEN}[+] Generando directorios del usuario (${REAL_USER})...${NC}"
  sudo -u "$REAL_USER" xdg-user-dirs-update || true
fi

if command -v sddm &> /dev/null; then
  echo -e "${GREEN}[+] Habilitando servicio SDDM...${NC}"
  systemctl enable sddm.service
  systemctl set-default graphical.target
fi

if [ -x "$(command -v zsh)" ]; then
  echo -e "${GREEN}[+] Cambiando shell por defecto a Zsh para ${REAL_USER}...${NC}"
  chsh -s "$(which zsh)" "$REAL_USER" || true
fi

echo -e "\n${BLUE}=== ¡Instalación completada con éxito! ===${NC}"
echo -e "${YELLOW}Ejecutá 'reboot' para reiniciar el sistema y entrar a SDDM.${NC}"
